{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    // `..` (packages/): the seam source below is outside this package; noEmit, so no output paths.
    "rootDir": "..",
    // The crypto test seam (M1-1g-b) is never built and has no package export: type-check it from
    // source, as vitest.config.ts resolves it. Only this noEmit config has the path; tsconfig.json
    // (the build) cannot resolve it, so no build can include it. `@4thtech-io/crypto` maps to the
    // same source, so the seam's types and the main entry's types are one copy.
    "paths": {
      "@4thtech-io/crypto": ["../crypto/src/index.ts"],
      "@4thtech-io/crypto/testing": ["../crypto/src/testing.ts"]
    }
  },
  "include": ["src", "test"],
  "exclude": [],
  "references": []
}
