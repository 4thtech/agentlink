{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    // Runtime-agnostic (06 §1): no Node types. Tests run in Node under tsconfig.test.json.
    "types": [],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../types" },
    { "path": "../log" },
    { "path": "../crypto" },
    { "path": "../chain" },
    { "path": "../core" }
  ]
}
