{
  "name": "@4thtech-io/mcp-tools",
  "version": "0.4.6",
  "private": true,
  "description": "The runtime-agnostic MCP tool handlers (registry, handlers, result helpers). Imported by the CLI and, later, by the cloud agent Worker.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thtech/agentlink.git",
    "directory": "packages/mcp-tools"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@4thtech-io/types": "workspace:*",
    "@4thtech-io/log": "workspace:*",
    "@4thtech-io/crypto": "workspace:*",
    "@4thtech-io/chain": "workspace:*",
    "@4thtech-io/core": "workspace:*"
  }
}
