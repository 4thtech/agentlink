{
  "name": "@4thtech-io/chain",
  "version": "0.4.5",
  "private": true,
  "description": "Chain clients and OCC v2 bindings.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thtech/agentlink.git",
    "directory": "packages/chain"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@4thtech-io/types": "workspace:*",
    "@4thtech-io/crypto": "workspace:*",
    "@4thtech-io/occ-v2-abi": "workspace:*",
    "viem": "2.57.4"
  }
}
