{
  "name": "@4thtech-io/ui",
  "version": "0.1.2",
  "private": true,
  "description": "Shared design system: design tokens (CSS and typed), Geist fonts; components follow.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thtech/agentlink.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src/tokens/tokens.css",
    "fonts",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  }
}
