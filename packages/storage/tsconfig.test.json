{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    // `..` (packages/): the seam source below is outside this package; noEmit, so no output paths.
    "rootDir": "..",
    // M1-6c: the crypto test seam (signDropAuthorization) is never built and has no package export:
    // type-check it from source, as vitest.config.ts resolves it for the drop-worker project. Only
    // this noEmit config has the path. `@4thtech-io/crypto` maps to the same source, so the seam's
    // types and the main entry's types are one copy.
    "paths": {
      "@4thtech-io/crypto": ["../crypto/src/index.ts"],
      "@4thtech-io/crypto/testing": ["../crypto/src/testing.ts"]
    }
  },
  "include": ["src", "test"],
  "exclude": [],
  "references": []
}
