{
  "name": "@4thtech-io/transport-nostr",
  "version": "0.4.1",
  "private": true,
  "description": "Nostr transport: gift wraps, relay pool, sync.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thtech/agentlink.git",
    "directory": "packages/transport-nostr"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@4thtech-io/types": "workspace:*",
    "@4thtech-io/log": "workspace:*",
    "@4thtech-io/crypto": "workspace:*"
  },
  "devDependencies": {
    "nostr-tools": "2.25.2"
  }
}
