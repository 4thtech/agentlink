{
  "name": "@4thtech-io/node",
  "version": "0.4.5",
  "private": true,
  "description": "Node implementations: keychain KeyStore, SQLite Store, local approval server.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thtech/agentlink.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@4thtech-io/core": "workspace:*",
    "@4thtech-io/crypto": "workspace:*",
    "@4thtech-io/transport-nostr": "workspace:*",
    "@napi-rs/keyring": "2.1.1",
    "better-sqlite3": "13.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@4thtech-io/types": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "axe-core": "4.14.0"
  }
}
