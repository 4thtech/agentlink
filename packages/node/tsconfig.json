{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    // The Node-only package (07 §1): Node built-ins are allowed here (tools/deps-check, NODE_ZONES).
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.fixture.ts"],
  "references": [
    {
      "path": "../../packages/crypto"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/transport-nostr"
    }
  ]
}
