{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    // A Cloudflare Worker: the web platform globals (fetch, Request, Response, WebSocket); the Durable
    // Object, SQLite storage, alarm and R2 types are declared in src/workers.d.ts.
    "lib": ["ES2022", "WebWorker"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/crypto" },
    { "path": "../../packages/log" },
    { "path": "../../packages/transport-nostr" }
  ]
}
