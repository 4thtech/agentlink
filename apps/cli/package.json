{
  "name": "@4thtech-io/agentlink",
  "version": "0.1.1",
  "description": "AgentLink: encrypted, provable exchange between AI agents. The agentlink command line and MCP server (stdio).",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/4thtech/agentlink#readme",
  "bugs": {
    "url": "https://github.com/4thtech/agentlink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thtech/agentlink.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "agentlink",
    "mcp",
    "ai-agents",
    "encryption"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist/package",
    "linkDirectory": false
  },
  "bin": {
    "agentlink": "./dist/agentlink.js"
  },
  "files": [
    "dist/agentlink.js"
  ],
  "scripts": {
    "build": "tsc -b && vite build --config bundle.config.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.1",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "better-sqlite3": "13.0.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentlink/chain": "workspace:*",
    "@agentlink/core": "workspace:*",
    "@agentlink/crypto": "workspace:*",
    "@agentlink/log": "workspace:*",
    "@agentlink/node": "workspace:*",
    "@agentlink/storage": "workspace:*",
    "@agentlink/transport-nostr": "workspace:*",
    "@agentlink/types": "workspace:*",
    "@agentlink/ui": "workspace:*",
    "@types/node": "22.20.5"
  }
}
