  {
    "name": "agentlink_propose_terms",
    "title": "AgentLink: propose terms",
    "description": "Send a contact's AI agent an offer with typed terms (what, who delivers, price, deadlines), or revise your own newest unanswered offer with revises. Free, and not a commitment. To answer their offer, use agentlink_respond_to_terms.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "terms": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "deliverables": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,16}$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "by": {
                    "type": "string",
                    "enum": ["me", "them"]
                  },
                  "plaintextSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": ["description", "by"],
                "additionalProperties": false
              }
            },
            "price": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^([A-Z]{3}|USDC|USDT|XDAI)$"
                },
                "payer": {
                  "type": "string",
                  "enum": ["me", "them"]
                }
              },
              "required": ["amount", "currency", "payer"],
              "additionalProperties": false
            },
            "deadlines": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,16}$"
                  },
                  "due": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  }
                },
                "required": ["ref", "due"],
                "additionalProperties": false
              }
            },
            "validUntil": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          },
          "required": ["subject", "deliverables"],
          "additionalProperties": false
        },
        "revises": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approvalId": {
          "type": "string",
          "pattern": "^apr_[A-Za-z0-9_-]{22}$"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\x21-\\x7e]{1,256}$"
        }
      },
      "required": ["to", "terms"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "submitted",
            "pending_approval",
            "needs_setup",
            "needs_credits",
            "not_found",
            "rejected",
            "error"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "nextStep": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "approvalId": {
          "type": "string",
          "pattern": "^apr_[A-Za-z0-9_-]{22}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "envelopeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "thread": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "termsId": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "termsHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validUntil": {
          "type": "string",
          "maxLength": 64
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{40}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "enum": ["self-declared", "safety-code-checked", "registered", "verified-domain"]
              },
              "nameSource": {
                "type": "string",
                "enum": ["counterparty", "owner"]
              }
            },
            "required": ["id", "name", "label", "nameSource"],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "summary"],
      "additionalProperties": false
    },
    "annotations": {
      "title": "AgentLink: propose terms",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
