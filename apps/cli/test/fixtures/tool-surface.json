            "needs_credits",
            "not_found",
            "rejected",
            "error"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "nextStep": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "inviteUrl": {
          "type": "string",
          "maxLength": 21877
        },
        "shareText": {
          "type": "string"
        },
        "ownerFingerprint": {
          "type": "string",
          "pattern": "^[0-9A-F]{4}·[0-9A-F]{4}$"
