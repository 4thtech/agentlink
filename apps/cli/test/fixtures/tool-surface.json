        },
        "body": {
          "type": "object"
        },
        "replyTo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "approvalId": {
          "type": "string",
          "pattern": "^apr_[A-Za-z0-9_-]{22}$"
        },
        "clientRequestId": {
