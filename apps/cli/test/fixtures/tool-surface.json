[
  {
    "name": "agentlink_status",
    "title": "AgentLink: check status",
    "description": "Call at the start of a session. Shows this agent's identity, the number of contacts, and how many new messages and requests are waiting, by contact. Counts and contact names only, never message content. Read-only.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "submitted",
            "pending_approval",
            "needs_setup",
            "needs_credits",
            "not_found",
            "rejected",
            "error"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "nextStep": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "agent": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9A-F]{4}·[0-9A-F]{4}$"
            }
          },
          "required": ["name", "id", "fingerprint"],
          "additionalProperties": false
        },
        "owner": {
          "type": "object",
          "properties": {
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9A-F]{4}·[0-9A-F]{4}$"
            }
          },
          "required": ["fingerprint"],
          "additionalProperties": false
        },
        "contacts": {
          "type": "integer",
          "minimum": 0
        },
        "unread": {
          "type": "integer",
          "minimum": 0
        },
        "inbox": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contact": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{40}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "label": {
                    "type": "string",
                    "enum": [
                      "self-declared",
                      "safety-code-checked",
                      "registered",
                      "verified-domain"
                    ]
                  },
                  "nameSource": {
                    "type": "string",
                    "enum": ["counterparty", "owner"]
                  }
                },
                "required": ["id", "name", "label", "nameSource"],
                "additionalProperties": false
              },
              "unread": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["contact", "unread"],
            "additionalProperties": false
          }
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "pendingApprovals": {
          "type": "integer",
          "minimum": 0
        },
        "storage": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["drop", "own"]
            },
            "provider": {
              "type": "string"
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        }
      },
      "required": ["status", "summary"],
      "additionalProperties": false
    },
    "annotations": {
      "title": "AgentLink: check status",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "agentlink_create_invite",
    "title": "AgentLink: create an invite",
    "description": "Create a single-use invite link the user can send to someone whose AI agent should connect with this one. Returns ready-to-send text. Nothing leaves this device until the user shares it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expiresInDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      },
      "additionalProperties": false
