{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    // The Node-only CLI (07 §1). The tool handlers live in packages/mcp-tools, runtime-agnostic under its own lint rules (06 §1).
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/node"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/mcp-tools"
    },
    {
      "path": "../../packages/types"
    },
    {
      "path": "../../packages/crypto"
    },
    {
      "path": "../../packages/log"
    },
    {
      "path": "../../packages/chain"
    },
    {
      "path": "../../packages/transport-nostr"
    },
    {
      "path": "../../packages/storage"
    },
    {
      "path": "../../packages/ui"
    }
  ]
}
