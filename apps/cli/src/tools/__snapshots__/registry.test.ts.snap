  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "approval": true,
    "description": "Add a proof to a message this agent already sent, named by its envelopeId: a public record that this exact message existed and was exchanged. It costs a small fee from credits (see agentlink_status prices); mention it unless the user asked for proof. Offers and answers to offers get their proof through agentlink_propose_terms and agentlink_respond_to_terms instead. AgentLink picks where to record it automatically; leave chain out unless the user explicitly asks for one. Set requestReceipt only when the user asked for a delivery receipt; a receipt, if the contact confirms, shows publicly that the message went to their agent. A pending_approval result's url is the owner's approval page: show it to the user; you must never open or fetch this link.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "approvalId": {
          "pattern": "^apr_[A-Za-z0-9_-]{22}$",
          "type": "string",
        },
        "chain": {
          "pattern": "^[a-z0-9-]{1,32}$",
          "type": "string",
        },
        "clientRequestId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]{1,256}$",
          "type": "string",
        },
        "envelopeId": {
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "type": "string",
        },
        "requestReceipt": {
          "type": "boolean",
        },
      },
      "required": [
        "envelopeId",
      ],
      "type": "object",
    },
    "name": "agentlink_notarize",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "advanced": {
          "additionalProperties": false,
          "properties": {
            "chain": {
              "pattern": "^[a-z0-9-]{1,32}$",
              "type": "string",
            },
          },
          "required": [
            "chain",
          ],
          "type": "object",
        },
        "agentAddress": {
          "pattern": "^0x[0-9a-f]{40}$",
          "type": "string",
        },
        "approvalId": {
          "pattern": "^apr_[A-Za-z0-9_-]{22}$",
          "type": "string",
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "type": "string",
        },
        "fee": {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string",
            },
            "integratorUsd": {
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
              "type": "string",
            },
            "protocolUsd": {
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
              "type": "string",
            },
            "token": {
              "pattern": "^0x[0-9a-f]{40}$",
              "type": "string",
            },
            "usd": {
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
              "type": "string",
            },
          },
          "required": [
            "token",
            "amount",
            "usd",
          ],
          "type": "object",
        },
        "nextStep": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "receipts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "at": {
                "maxLength": 64,
                "type": "string",
              },
              "type": {
                "enum": [
                  "DELIVERED",
                  "OPENED",
                  "ACCEPTED",
                  "REJECTED",
                ],
                "type": "string",
              },
            },
            "required": [
              "type",
              "at",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "recordId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string",
        },
        "status": {
          "enum": [
            "ok",
            "submitted",
            "pending_approval",
            "needs_setup",
            "needs_credits",
            "not_found",
            "rejected",
            "error",
          ],
          "type": "string",
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "topUpUrl": {
          "maxLength": 2048,
          "pattern": "^https://pay\\.agentlink\\.4thtech\\.io/",
          "type": "string",
        },
        "txHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string",
        },
        "url": {
          "maxLength": 2048,
          "type": "string",
        },
      },
      "required": [
        "status",
        "summary",
      ],
      "type": "object",
    },
    "title": "AgentLink: add proof to a sent message",
