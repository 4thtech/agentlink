    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "approvalId": {
          "pattern": "^apr_[A-Za-z0-9_-]{22}$",
          "type": "string",
        },
        "clientRequestId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]{1,256}$",
          "type": "string",
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "counter",
          ],
          "type": "string",
        },
        "envelopeId": {
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "type": "string",
        },
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "terms": {
          "additionalProperties": false,
          "properties": {
            "deadlines": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "due": {
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                    "type": "string",
                  },
                  "ref": {
                    "pattern": "^[A-Za-z0-9_-]{1,16}$",
                    "type": "string",
                  },
                },
                "required": [
                  "ref",
                  "due",
                ],
                "type": "object",
              },
              "maxItems": 10,
              "type": "array",
            },
            "deliverables": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "by": {
                    "enum": [
                      "me",
                      "them",
                    ],
                    "type": "string",
                  },
                  "description": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string",
                  },
                  "id": {
                    "pattern": "^[A-Za-z0-9_-]{1,16}$",
                    "type": "string",
                  },
                  "plaintextSha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string",
                  },
                },
                "required": [
                  "description",
                  "by",
                ],
                "type": "object",
              },
              "maxItems": 10,
              "minItems": 1,
              "type": "array",
            },
            "price": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
                  "type": "string",
                },
                "currency": {
                  "pattern": "^([A-Z]{3}|USDC|USDT|XDAI)$",
                  "type": "string",
                },
                "payer": {
                  "enum": [
                    "me",
                    "them",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "amount",
                "currency",
                "payer",
              ],
              "type": "object",
            },
            "subject": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string",
            },
            "validUntil": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string",
            },
          },
          "required": [
            "subject",
            "deliverables",
          ],
          "type": "object",
        },
      },
      "required": [
        "envelopeId",
        "decision",
      ],
      "type": "object",
    },
    "name": "agentlink_respond_to_terms",
    "outputSchema": {
      "additionalProperties": false,
