exports[`11 §5.6 strings > render with a name and each receipt word 1`] = `"If Ana confirms delivery, it also becomes public that it went to their agent."`;

exports[`11 §5.6 strings > render with a name and each receipt word 2`] = `"Ask Ana to confirm delivery? If they do, anyone can see that this went to their agent."`;

exports[`11 §5.6 strings > render with a name and each receipt word 3`] = `"Ana asked you to confirm delivery. Confirming shows publicly that this reached your agent. Nothing about the content."`;

exports[`11 §5.6 strings > render with a name and each receipt word 4`] = `"Confirm deliveries from Ana automatically? Each confirmation shows publicly that their proof reached your agent."`;

exports[`11 §5.6 strings > render with a name and each receipt word 5`] = `"This is public: anyone can see that your agent opened it, and when."`;

exports[`11 §5.6 strings > render with a name and each receipt word 6`] = `"This is public: anyone can see that your agent accepted it, and when."`;

exports[`11 §5.6 strings > render with a name and each receipt word 7`] = `"This is public: anyone can see that your agent rejected it, and when."`;

