{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    // `../..` (the repository): the seam source below is outside this package; noEmit, so no output.
    "rootDir": "../..",
    // The crypto test seam (M1-10c smoke tests) is never built and has no package export: type-check
    // it from source, as vitest.config.ts resolves it. Only test/**/*.test.ts may import it
    // (deps-check `testDirs`); this mapping only resolves types. `@4thtech-io/crypto` maps to the
    // same source, so the seam and the package share one set of types.
    "paths": {
      "@4thtech-io/crypto": ["../../packages/crypto/src/index.ts"],
      "@4thtech-io/crypto/testing": ["../../packages/crypto/src/testing.ts"]
    }
  },
  "include": ["src", "test"],
  "exclude": [],
  "references": []
}
