# Headers of the invite host (08 §4, D-53, M1-19). Read by Cloudflare static hosting; the tests read
# the same file. The CSP allows one first-party script file and nothing else: no inline script or
# style, no connection except to the drop host (a short-link invite object, D-139, 04 §3.6.2), no
# framing, and no HTML sink under Trusted Types.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://drop.agentlink.4thtech.io; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cache-Control: no-store

# INSTALLER-1 (owner Decision 58): the one-line installers are plain text, never run by a browser.
# They keep the headers above, including Cache-Control: no-store, so a fix is live at once.
/install.sh
  Content-Type: text/plain; charset=utf-8
/install.ps1
  Content-Type: text/plain; charset=utf-8
