{
  "name": "@4thtech-io/invite",
  "version": "0.0.1",
  "private": true,
  "description": "Invite host: static how-to-install page that reads the invite in the browser (08 §4, D-53).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thtech/agentlink.git",
    "directory": "apps/invite"
  },
  "sideEffects": [
    "./src/interpreted-parsers.ts",
    "./src/main.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@4thtech-io/core": "workspace:*",
    "@4thtech-io/crypto": "workspace:*",
    "@4thtech-io/types": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
