{
  "name": "agentlink",
  "version": "0.0.0",
  "private": true,
  "description": "AgentLink monorepo root: encrypted, provable exchange between AI agents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thtech/agentlink.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint check && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test:e2e": "turbo run test:e2e",
    "vectors:check": "node tools/vectors/check.mjs",
    "format": "prettier --write .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/vitest-plugin": "1.3.3",
    "@eslint/js": "10.0.1",
    "@vitest/browser-playwright": "4.1.11",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
