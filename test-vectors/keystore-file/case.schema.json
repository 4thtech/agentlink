{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/keystore-file/case.schema.json",
  "title": "keystore-file case",
  "description": "04 \u00a72.8 ALKS v1 and ALKO v1. `password`: the Argon2id password bytes for a secret, its kind and its source (file input loses one trailing newline), or a rejection. `kek`: the key-encryption key for `format` ALKS or ALKO. `seal` / `sealAlko`: the whole blob as hex. `open`: entry names (comma-separated, in file order) and each value as `entry:<name>` hex, or a rejection. `openAlko`: the 32-byte owner seed, or a rejection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "secretKind",
            "secret",
            "source"
          ],
          "properties": {
            "op": {
              "const": "password"
            },
            "secretKind": {
              "type": "integer"
            },
            "secret": {
              "type": "string"
            },
            "source": {
              "enum": [
                "prompt",
                "file"
              ]
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "password"
              ],
              "properties": {
                "password": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "format",
            "secretKind",
            "secret",
            "source",
            "salt",
            "memoryKiB",
            "iterations",
            "parallelism"
          ],
          "properties": {
            "op": {
              "const": "kek"
            },
            "format": {
              "enum": [
                "ALKS",
                "ALKO"
              ]
            },
            "secretKind": {
              "type": "integer"
            },
            "secret": {
              "type": "string"
            },
            "source": {
              "enum": [
                "prompt",
                "file"
              ]
            },
            "salt": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "memoryKiB": {
              "type": "integer"
            },
            "iterations": {
              "type": "integer"
            },
            "parallelism": {
              "type": "integer"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kek"
          ],
          "properties": {
            "kek": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "secretKind",
            "secret",
            "source",
            "salt",
            "memoryKiB",
            "iterations",
            "parallelism",
            "nonce",
            "agentId",
            "entries"
          ],
          "properties": {
            "op": {
              "const": "seal"
            },
            "secretKind": {
              "type": "integer"
            },
            "secret": {
              "type": "string"
            },
            "source": {
              "enum": [
                "prompt",
                "file"
              ]
            },
            "salt": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "memoryKiB": {
              "type": "integer"
            },
            "iterations": {
              "type": "integer"
            },
            "parallelism": {
              "type": "integer"
            },
            "nonce": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "agentId": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  }
                }
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "file",
            "secret",
            "source",
            "expectedAgentId"
          ],
          "properties": {
            "op": {
              "const": "open"
            },
            "file": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "secret": {
              "type": "string"
            },
            "source": {
              "enum": [
                "prompt",
                "file"
              ]
            },
            "expectedAgentId": {
              "type": "string"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "entryNames"
              ],
              "properties": {
                "entryNames": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "^entry:": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "secretKind",
            "secret",
            "source",
            "salt",
            "memoryKiB",
            "iterations",
            "parallelism",
            "nonce",
            "seed"
          ],
          "properties": {
            "op": {
              "const": "sealAlko"
            },
            "secretKind": {
              "type": "integer"
            },
            "secret": {
              "type": "string"
            },
            "source": {
              "enum": [
                "prompt",
                "file"
              ]
            },
            "salt": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "memoryKiB": {
              "type": "integer"
            },
            "iterations": {
              "type": "integer"
            },
            "parallelism": {
              "type": "integer"
            },
            "nonce": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "seed": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "file",
            "secret",
            "source",
            "expectedOwner",
            "fileKeystoreMachine"
          ],
          "properties": {
            "op": {
              "const": "openAlko"
            },
            "file": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "secret": {
              "type": "string"
            },
            "source": {
              "enum": [
                "prompt",
                "file"
              ]
            },
            "expectedOwner": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ownerEvm",
                "ownerNostr"
              ],
              "properties": {
                "ownerEvm": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                },
                "ownerNostr": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                }
              }
            },
            "fileKeystoreMachine": {
              "type": "boolean"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seed"
              ],
              "properties": {
                "seed": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
