{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/ucd15-table/case.schema.json",
  "title": "ucd15-table case",
  "description": "The pinned UCD 15.0.0 refused-category table of @4thtech-io/types: tableHash (hex SHA-256 of the canonical serialization, and the number of runs), categoryCounts (decimal counts), and category (the refused category of one code point, or `none`).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "tableHash"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hash",
            "runs"
          ],
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "runs": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "categoryCounts"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Cc",
            "Cf",
            "Zl",
            "Zp",
            "Co",
            "Cs",
            "Cn"
          ],
          "properties": {
            "Cc": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "Cf": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "Zl": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "Zp": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "Co": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "Cs": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "Cn": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "codePoint"
          ],
          "properties": {
            "op": {
              "const": "category"
            },
            "codePoint": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1114111
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category"
          ],
          "properties": {
            "category": {
              "enum": [
                "Cc",
                "Cf",
                "Zl",
                "Zp",
                "Co",
                "Cs",
                "Cn",
                "none"
              ]
            }
          }
        }
      }
    }
  ]
}
