                    "type": "string",
                    "pattern": "^0x[0-9a-f]{40}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "value"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{2})*$"
                        }
                      }
                    }
                  },
                  "store": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  }
                }
              }
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kit",
                "kek"
              ],
              "properties": {
                "kit": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
