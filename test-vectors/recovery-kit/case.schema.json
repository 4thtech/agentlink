                },
                "iterations": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "parallelism": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            },
            {
