{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/recovery-kit/case.schema.json",
  "title": "recovery-kit case",
  "description": "04 \u00a72.3.3 recovery kit ALKK v1 (D-115). `kek`: the key-encryption key for a code, salt and KDF parameters. `seal`: the whole kit and its kek for a fixed code, salt, nonce prefix and chunk size, the owner seed, the manifest fields and per agent its items (in any order) and store. `open` (with the code; an empty `expectedOwnerNostr` means no expected owner) and `openWithKek`: entry names (comma-separated, in kit order) and each value as `entry:<name>` hex, or a rejection. `header`: the public header fields read before the code is asked for, or a rejection. `crossType`: another format's reader (ALKP with `key` as the PRF output, ALKR and ALKS and ALKO with `code`, ALF1 with `key` as the file key) given an ALKK kit, which it refuses. Hex without 0x except agent and owner keys in the ALKO and ALKS inputs; codes as text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "code",
            "salt",
            "memoryKiB",
            "iterations",
            "parallelism"
          ],
          "properties": {
            "op": {
              "const": "kek"
            },
            "code": {
              "type": "string"
            },
            "salt": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "memoryKiB": {
              "type": "integer"
            },
            "iterations": {
              "type": "integer"
            },
            "parallelism": {
              "type": "integer"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kek"
          ],
          "properties": {
            "kek": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "code",
            "salt",
            "noncePrefix",
            "chunkSize",
            "memoryKiB",
            "iterations",
            "parallelism",
            "ownerSeed",
            "kitId",
            "createdAt",
            "contents",
            "agents"
          ],
          "properties": {
            "op": {
              "const": "seal"
            },
            "code": {
              "type": "string"
            },
            "salt": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "noncePrefix": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "chunkSize": {
              "type": "integer"
            },
            "memoryKiB": {
              "type": "integer"
            },
            "iterations": {
              "type": "integer"
            },
            "parallelism": {
              "type": "integer"
            },
            "ownerSeed": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kitId": {
              "type": "string"
            },
            "createdAt": {
              "type": "integer"
            },
            "contents": {
              "enum": [
                "full",
