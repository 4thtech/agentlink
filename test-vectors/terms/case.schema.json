          ],
          "properties": {
            "op": {
              "const": "parseTermsBody"
            },
            "type": {
              "type": "string"
            },
            "body": {}
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
