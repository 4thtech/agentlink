              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome",
                "termsHash"
              ],
              "properties": {
                "outcome": {
                  "const": "accept"
                },
                "termsHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    },
    {
