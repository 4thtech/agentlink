{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/terms/case.schema.json",
  "title": "terms case",
  "description": "04 \u00a73.4 (D-32, D-55, D-74), 06 \u00a72.2a: terms, termsHash, the offer/accept/reject body, TermsInput and its mapping, the Unicode 15.0 runtime probe, and the negotiation chain (see tools/vectors/generate_terms.py for the abstract envelope model).",
