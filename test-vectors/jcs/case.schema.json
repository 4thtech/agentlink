{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/jcs/case.schema.json",
  "title": "jcs case",
  "description": "RFC 8785 JCS. `canonicalize`: parse `json` (JSON text) and canonicalise; expected UTF-8 bytes as hex and their SHA-256, or a rejection. `number`: serialise the IEEE 754 double given as 16 hex digits (big-endian bits); expected JSON text, or a rejection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "json"
          ],
          "properties": {
            "op": {
              "const": "canonicalize"
            },
            "json": {
              "type": "string"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "utf8",
                "sha256"
              ],
              "properties": {
                "utf8": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "ieee754"
          ],
          "properties": {
            "op": {
              "const": "number"
            },
            "ieee754": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "json"
              ],
              "properties": {
                "json": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
