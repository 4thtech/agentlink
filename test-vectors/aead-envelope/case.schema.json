{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/aead-envelope/case.schema.json",
  "title": "aead-envelope case",
  "description": "04 \u00a73.1, \u00a73.3 envelope with key commitment (G-46, D-66). `deriveFromCek`: the payload-key or payload-commit derivation (HKDF-SHA256, ikm = CEK, empty salt, info = utf8(label) || raw 16-byte id) or a refusal. `envelopeHash`, `aad`: hashes of the given envelope. `encryptPayload`: AAD, base64url kc and base64url ct||tag (AES-256-GCM under encKey) for header, CEK, IV and plaintext. `decryptPayload`: plaintext or rejection (kc checked first). `checkCommitment`: whether aead.kc is the kc of the CEK. `sign`: envelopeHash, tagged signature input and sig. `verify`: accept or reject. `validate`: structure, encodings and signature together (strict). `verifyJson`: the envelope as received JSON text, parsed strictly (no duplicate or escaped member names, integer tokens only; 04 \u00a73.1.1 step 3, \u00a72.5.1), then `validate`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "label",
            "cek",
            "envelopeId"
          ],
          "properties": {
            "op": {
              "const": "deriveFromCek"
            },
            "label": {
              "type": "string"
            },
            "cek": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "envelopeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "okm"
              ],
              "properties": {
                "okm": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    },
    {
