                      "expiresAt"
                    ],
                    "properties": {
                      "approvalId": {
                        "type": "string"
                      },
                      "actionDigest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "expiresAt": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "pairings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "contact",
                      "contactCard",
                      "handshake",
                      "ack"
                    ],
                    "properties": {
                      "contact": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{40}$"
                      },
                      "contactCard": {
                        "type": "object"
                      },
                      "handshake": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "envelope",
                          "cek"
                        ],
                        "properties": {
                          "envelope": {
                            "type": "object"
                          },
                          "cek": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        }
                      },
                      "ack": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "envelope",
                          "cek"
                        ],
                        "properties": {
                          "envelope": {
                            "type": "object"
                          },
                          "cek": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        }
                      }
                    }
                  }
                },
                "appliedPolicyVersion": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "accept"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
