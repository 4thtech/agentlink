{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/schema/vector-file.schema.json",
  "title": "AgentLink test-vector file",
  "description": "Envelope of every test-vectors/<suite>/vectors.json. The shape of each case is checked by the suite's own case.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "version", "generator", "cases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "suite": {
      "description": "Suite name; equals the directory name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "description": "Version of this suite's vectors. Bumped only together with a spec change.",
      "type": "integer",
      "minimum": 1
    },
    "generator": {
      "description": "The independent generator that produced the file (never the TypeScript code under test).",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "script"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "description": "Repository path of the generator script.",
          "type": "string",
          "pattern": "^tools/vectors/[A-Za-z0-9_-]+\\.py$"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "input", "expected"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "source": {
            "description": "Where the input and the expected value come from (publication, section).",
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          },
          "expected": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  }
}
