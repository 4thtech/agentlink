{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/placeholder-sha256/case.schema.json",
  "title": "placeholder-sha256 case",
  "description": "SHA-256 of a message given as hex, repeated `repeat` times.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "input", "expected"],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hex", "repeat"],
      "properties": {
        "hex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
