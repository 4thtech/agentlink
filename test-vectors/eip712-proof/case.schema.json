{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/eip712-proof/case.schema.json",
  "title": "eip712-proof case",
  "description": "EIP-712 hashing of the OCC v2 proof types (05 \u00a73.1, \u00a74; 04 \u00a75). `record`, `receipt`, `registration`: typeHash, domain separator, struct hash and digest (32-byte hex without 0x) of a message in its 05 \u00a73.1 JSON form under a domain {name, version, chainId, verifyingContract}, or a rejection of a non-canonical Record or Receipt. `recipientCommitment`: keccak256(abi.encode(recipient, salt)) as 0x + 64 hex.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "domain",
            "record"
          ],
          "properties": {
            "op": {
              "const": "record"
            },
            "domain": {
              "type": "object"
            },
            "record": {
              "type": "object"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "typeHash",
                "domainSeparator",
                "structHash",
                "digest"
              ],
              "properties": {
                "typeHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "domainSeparator": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "structHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "domain",
            "receipt"
          ],
          "properties": {
            "op": {
              "const": "receipt"
            },
            "domain": {
              "type": "object"
            },
            "receipt": {
              "type": "object"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "typeHash",
                "domainSeparator",
                "structHash",
                "digest"
              ],
              "properties": {
                "typeHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "domainSeparator": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "structHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "domain",
            "registration"
          ],
          "properties": {
            "op": {
              "const": "registration"
            },
            "domain": {
              "type": "object"
            },
            "registration": {
              "type": "object"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typeHash",
            "domainSeparator",
            "structHash",
            "digest"
          ],
          "properties": {
            "typeHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "domainSeparator": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "structHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "recipient",
            "salt"
          ],
          "properties": {
            "op": {
              "const": "recipientCommitment"
            },
            "recipient": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "salt": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recipientCommitment"
          ],
          "properties": {
            "recipientCommitment": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  ]
}
