                },
                "ownerNostr": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "ownerEnc": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "nameHash": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "relaysHash": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "issuedAt": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "expiresAt": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "keyEpoch": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            },
            "secretKey": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "r",
            "s",
            "yParity"
          ],
          "properties": {
            "r": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "s": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "yParity": {
