                  "pattern": "^0x[0-9a-f]{40}$"
                },
                "ownerNostr": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "ownerEnc": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "nameHash": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "relaysHash": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "issuedAt": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "expiresAt": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "keyEpoch": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typeHash",
            "domainSeparator",
            "structHash",
            "digest"
          ],
          "properties": {
            "typeHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "domainSeparator": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "structHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
