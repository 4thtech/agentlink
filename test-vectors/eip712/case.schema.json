{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/eip712/case.schema.json",
  "title": "eip712 case",
  "description": "EIP-712. `typedData`: domain separator, hashStruct(message) and digest of full typed data. `signTypedData`, `signAgentCard`: deterministic ECDSA r, s, yParity. `agentCard`: typeHash, domain separator, struct hash and digest of an AgentCard under the chain-agnostic domain. `cardHashes`: nameHash and relaysHash. `verifyAgentCard`: whether the signature is the card owner's. Hashes are 32-byte hex without 0x.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "typedData"
          ],
          "properties": {
            "op": {
              "const": "typedData"
            },
            "typedData": {
              "type": "object"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domainSeparator",
            "structHash",
            "digest"
          ],
          "properties": {
            "domainSeparator": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "structHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "typedData",
            "secretKey"
          ],
          "properties": {
            "op": {
              "const": "signTypedData"
            },
            "typedData": {
              "type": "object"
            },
            "secretKey": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "r",
            "s",
            "yParity"
          ],
          "properties": {
            "r": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "s": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "yParity": {
              "enum": [
                "0",
                "1"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "card"
          ],
          "properties": {
            "op": {
              "const": "agentCard"
            },
            "card": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "agentEvm",
                "agentNostr",
                "agentEnc",
                "ownerEvm",
                "ownerNostr",
                "ownerEnc",
                "nameHash",
                "relaysHash",
                "issuedAt",
                "expiresAt",
                "keyEpoch"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "agentEvm": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{40}$"
                },
                "agentNostr": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "agentEnc": {
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
