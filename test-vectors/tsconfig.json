{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The harness runs in Node, browsers and workerd: only the common web platform (DOM lib for
    // WebCrypto, TextEncoder, navigator) and Vite's import.meta.glob typings. No @types/node.
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    // The crypto test seam (M1-1c, M1-1f) is never built and has no package export: type-check it from
    // source, as vitest.config.ts resolves it.
    // M1-7c: two @4thtech-io/core modules, from source as vitest.config.ts resolves them.
    "paths": {
      "@4thtech-io/crypto/testing": ["../packages/crypto/src/testing.ts"],
      "@4thtech-io/core/invite-link": ["../packages/core/src/invite-link.ts"],
      "@4thtech-io/core/safety-code": ["../packages/core/src/safety-code.ts"]
    },
    "composite": false,
    "declaration": false,
    "noEmit": true
  },
  "include": ["harness", "vitest.config.ts"]
}
