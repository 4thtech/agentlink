{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The harness runs in Node, browsers and workerd: only the common web platform (DOM lib for
    // WebCrypto, TextEncoder, navigator) and Vite's import.meta.glob typings. No @types/node.
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    // The crypto test seam (M1-1c) is never built and has no package export: type-check it from
    // source, as vitest.config.ts resolves it.
    "paths": { "@agentlink/crypto/testing": ["../packages/crypto/src/testing.ts"] },
    "composite": false,
    "declaration": false,
    "noEmit": true
  },
  "include": ["harness", "vitest.config.ts"]
}
