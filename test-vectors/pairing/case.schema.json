{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4thtech/agentlink/test-vectors/pairing/case.schema.json",
  "title": "pairing case",
  "description": "HMAC-SHA256 (the pairing proof primitive, 04 \u00a73.6): key and data hex to the 32-byte MAC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key",
            "data"
          ],
          "properties": {
            "op": {
              "const": "hmacSha256"
            },
            "key": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "data": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mac"
          ],
          "properties": {
            "mac": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  ]
}
