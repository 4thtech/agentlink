            "nonce": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "plaintext": {
              "type": "string"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload"
          ],
          "properties": {
            "payload": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "conversationKey",
            "payload"
          ],
          "properties": {
            "op": {
              "const": "decrypt"
            },
            "conversationKey": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload": {
              "type": "string"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "plaintext"
              ],
              "properties": {
                "plaintext": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "reject"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "conversationKey",
            "nonce",
            "pattern",
            "repeat"
          ],
          "properties": {
            "op": {
              "const": "encryptLong"
            },
            "conversationKey": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "nonce": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pattern": {
              "type": "string"
            },
            "repeat": {
              "type": "integer"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plaintextSha256",
            "payloadSha256"
          ],
          "properties": {
            "plaintextSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payloadSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "length"
          ],
          "properties": {
            "op": {
              "const": "encryptLength"
            },
            "length": {
              "type": "integer"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "const": "reject"
            }
          }
        }
      }
    }
  ]
}
