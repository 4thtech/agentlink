  "palette": {
    "signal-orange": {
      "$value": "#ff6a1a",
      "$type": "color",
      "$description": "Brand signal orange. The seal in the mark; accent fill in dark."
    },
    "4thtech-green": {
      "$value": "#2cd8a7",
      "$type": "color",
      "$description": "Endorsing brand only. Not part of the AgentLink UI palette."
    }
  }
}