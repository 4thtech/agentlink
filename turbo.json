{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs",
    "pnpm-workspace.yaml",
    "tools/deps-check/*.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VERIFY_BROWSERS"]
    },
    "lint": {},
    "check": {
      "cache": false
    },
    "vectors:check": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
